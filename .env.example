# Okim Dive — environment template (M1). Copy to .env.local; never commit values.

# Neon Postgres (free tier). Swapping Postgres hosts = change this URL only.
DATABASE_URL=

# Auth.js
AUTH_SECRET=
# Local preview runs on 3100 (3000 is taken by another app); magic links embed this URL.
AUTH_URL=http://localhost:3100
# Comma-separated instructor allowlist (Iris + Jeff during build)
AUTH_INSTRUCTOR_EMAILS=

# Resend (free tier, 3,000/mo). Sending domain purchased separately (~SGD 15/yr).
RESEND_API_KEY=
EMAIL_FROM=Okim Dive <no-reply@example.com>

# Cloudflare R2 (S3-compatible) — payment screenshots only (M4)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
